{
  "name": "@penumbral-labs/pi-copy-code",
  "version": "0.3.0",
  "description": "A pi extension for ergonomic copying of assistant code blocks.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "clipboard",
    "code-blocks"
  ],
  "license": "MIT",
  "author": "Aaron Small",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penumbral-labs/pi-copy-code.git"
  },
  "homepage": "https://github.com/penumbral-labs/pi-copy-code#readme",
  "bugs": {
    "url": "https://github.com/penumbral-labs/pi-copy-code/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/copy-code/index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/copy-code/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "smoke-package": "node scripts/smoke-package.mjs",
    "check": "npm run typecheck && npm test && npm run verify-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "22.19.20",
    "jiti": "2.7.0",
    "typescript": "7.0.2"
  }
}
